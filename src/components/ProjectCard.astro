---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
---
<article class="chip group relative bg-white p-2.5 pb-5 text-ink" data-reveal style={`--i:${index}`}>
  <div class="relative aspect-[4/5] overflow-hidden" style={`background:${p.chip.swatch}`}>
    <Image src={p.cover.src} alt={p.cover.alt} widths={[400, 700]} sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw" class="shot absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
    <span class="absolute left-3 top-3 rounded-full bg-white/85 px-2.5 py-1 font-mono text-[10px]">{p.kind}</span>
  </div>
  <div class="px-1.5">
    <p class="mt-4 text-sm font-bold tracking-wide">{p.chip.name}</p>
    <p class="font-mono text-[11px]">{p.chip.code} · {p.year}</p>
    <h3 class="mt-4 text-2xl font-medium tracking-tight">
      <a href={`/work/${p.slug}/`} class="after:absolute after:inset-0">{p.title}</a>
    </h3>
    <p class="mt-1 text-sm opacity-70">{p.summary}</p>
    <p class="mt-3 font-mono text-[11.5px] text-blue">↑ {p.outcome}</p>
    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tags">
      {p.tags.map((t) => <li class="rounded bg-mist px-2 py-0.5 font-mono text-[10.5px]">{t}</li>)}
    </ul>
    <div class="relative z-10 mt-4 flex gap-4 text-[13px] font-medium">
      <a href={`/work/${p.slug}/`}>Case study →</a>
      {p.live && <a href={p.live} target="_blank" rel="noopener">Live ↗</a>}
      {p.repo && <a href={p.repo} target="_blank" rel="noopener">Code ↗</a>}
    </div>
  </div>
</article>

<style>
  .chip { box-shadow: 0 20px 40px -22px rgba(30,30,60,.45); transition: transform .45s cubic-bezier(.2,.7,.2,1), box-shadow .45s; }
  .chip.is-in:hover, .chip.is-in:focus-within { transform: translateY(-8px) rotate(-.6deg); box-shadow: 0 34px 50px -24px rgba(46,59,255,.45); }
  .shot { mix-blend-mode: normal; opacity: .92; transition: opacity .4s, transform .8s cubic-bezier(.2,.7,.2,1); }
  .chip:hover .shot { opacity: 1; transform: scale(1.03); }
</style>
