---
import { site } from '../data/site';
---
<section class="foil grain relative isolate flex min-h-[100svh] flex-col overflow-hidden" aria-labelledby="hero-title" style="--grain-opacity:.28">
  <canvas id="hero-canvas" class="absolute inset-0 -z-10 h-full w-full opacity-0 transition-opacity duration-[1200ms]" aria-hidden="true"></canvas>

  <div class="relative mt-auto px-5 pb-10 pt-32 sm:px-10 sm:pb-12">
    <p class="mb-4 font-mono text-[13px] text-blue" aria-hidden="true">
      &gt; <span id="typed">{site.roles[0]}</span><span class="caret ml-0.5 inline-block h-[15px] w-2 translate-y-[2px] bg-blue"></span>
    </p>
    <p class="sr-only">{site.name}: {site.roles.join(', ')}.</p>

    <h1 id="hero-title" class="hero-title max-w-[14ch] text-[19vw] leading-[0.86] font-medium tracking-[-0.045em] sm:text-[13vw] lg:text-[10.5vw]">
      <span class="line"><span>Ayla</span> <span class="serif-accent">builds</span></span>
      <span class="line"><span>with</span> <span class="serif-accent">light.</span></span>
    </h1>

    <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
      <p class="max-w-sm text-[15px] leading-relaxed">
        Full-stack developer and designer making fast, accessible websites shaped around your business, and AI agents that do real work.
      </p>
      <div class="flex items-center gap-5 font-mono text-xs">
        {site.availability && <span class="flex items-center gap-2"><i class="block h-2 w-2 rounded-full bg-[#3ccf8e]"></i>{site.availability}</span>}
        <a href="#intro" class="flex items-center gap-3">scroll <span class="block h-10 w-px bg-ink" aria-hidden="true"></span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-title .line { display: block; overflow: hidden; padding-bottom: .04em; }
  .hero-title .line > span { display: inline-block; animation: rise 1.1s cubic-bezier(.2,.7,.2,1) both; }
  .hero-title .line:nth-child(1) > span:nth-child(2) { animation-delay: .08s; }
  .hero-title .line:nth-child(2) > span:nth-child(1) { animation-delay: .16s; }
  .hero-title .line:nth-child(2) > span:nth-child(2) { animation-delay: .24s; }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  .caret { animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  #hero-canvas.is-ready { opacity: 1; }
</style>

<script>
  import { site } from '../data/site';
  import { prefersReducedMotion } from '../scripts/reveal';

  // Typed roles.
  const typed = document.getElementById('typed');
  if (typed && !prefersReducedMotion()) {
    let r = 0;
    const roles = site.roles;
    const wait = (ms: number) => new Promise((res) => setTimeout(res, ms));
    (async () => {
      await wait(2200);
      for (;;) {
        const word = roles[r];
        for (let i = word.length; i >= 0; i--) { typed.textContent = word.slice(0, i); await wait(28); }
        r = (r + 1) % roles.length;
        const next = roles[r];
        for (let i = 1; i <= next.length; i++) { typed.textContent = next.slice(0, i); await wait(55); }
        await wait(2400);
      }
    })();
  }

  // 3D glass: loaded only when WebGL is available, after first paint.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const hasWebGL = (() => {
    try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
  })();
  if (canvas && hasWebGL) {
    const start = () => import('../scripts/hero-glass').then((m) => m.mountHeroGlass(canvas));
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 300);
  }
</script>
