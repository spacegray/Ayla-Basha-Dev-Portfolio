---
import { experience, education, skills } from '../data/experience';
import { site } from '../data/site';
---
<section id="about" class="relative bg-white px-5 py-24 sm:px-10 sm:py-32" aria-labelledby="exp-title">
  <div class="grid gap-16 lg:grid-cols-[1fr_1.4fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow opacity-60">06 / experience</p>
      <h2 id="exp-title" class="mt-4 text-[clamp(2.4rem,5vw,4rem)] leading-[0.95] font-medium tracking-[-0.035em]" data-reveal>Code, stage, and <span class="serif-accent">service.</span></h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed opacity-75" data-reveal>
        Programming has been my outlet for problem-solving and creative expression. My background in music, political science and digital marketing shapes how I build: for real people, under real pressure.
      </p>
      {site.resumeHref && <a href={site.resumeHref} class="mt-6 inline-block rounded-full border border-ink px-5 py-2.5 text-sm" download>Download resume ↓</a>}

      <div class="mt-12 space-y-6">
        {skills.map((g) => (
          <div data-reveal>
            <h3 class="eyebrow opacity-60">{g.group}</h3>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {g.items.map((s) => <li class="rounded-md border border-ink/15 bg-mist px-2.5 py-1 text-[13px]">{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div>
      <ol class="relative border-l border-ink/20">
        {experience.map((r, i) => (
          <li class="relative pb-10 pl-8 last:pb-0" data-reveal style={`--i:${Math.min(i, 3)}`}>
            <span class="absolute -left-[5px] top-2 h-[9px] w-[9px] rounded-full bg-blue ring-4 ring-white" aria-hidden="true"></span>
            <p class="font-mono text-xs opacity-60">{r.start} – {r.end}{r.location ? ` · ${r.location}` : ''}</p>
            <h3 class="mt-1 text-xl font-medium">{r.title} <span class="opacity-60">· {r.company}</span></h3>
            <p class="mt-2 max-w-prose text-sm leading-relaxed opacity-75">{r.body}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Technologies">
              {r.tech.map((t) => <li class="rounded bg-mist px-2 py-0.5 font-mono text-[10.5px]">{t}</li>)}
            </ul>
          </li>
        ))}
      </ol>
      <div class="mt-14 border-t border-ink/15 pt-6" data-reveal>
        <h3 class="eyebrow opacity-60">Education</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {education.map((e) => <li><span class="font-medium">{e.title}</span> · {e.org}, {e.year}{e.note ? ` · ${e.note}` : ''}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
