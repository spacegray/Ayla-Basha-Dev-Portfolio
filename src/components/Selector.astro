---
import { Image } from 'astro:assets';
import { industries } from '../data/industries';
import { getProject } from '../data/projects';
import crystal from '../assets/textures/crystal-glass-oxblood.webp';
const first = industries[0];
---
<section id="building" class="theme-panel relative isolate overflow-hidden text-[var(--fg)]" data-theme={first.id} aria-labelledby="building-title">
  <!-- Theme backgrounds, crossfaded by the script below -->
  <div class="theme-bg bg-realestate is-active" data-bg="realestate" aria-hidden="true"></div>
  <div class="theme-bg" data-bg="artist" aria-hidden="true">
    <Image src={crystal} alt="" widths={[900, 1774]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(20,3,8,.35),rgba(20,3,8,.6)_55%,rgba(20,3,8,.8))]"></div>
  </div>
  <div class="theme-bg bg-restaurant" data-bg="restaurant" aria-hidden="true"></div>
  <div class="theme-bg bg-shop" data-bg="shop" aria-hidden="true"></div>
  <div class="theme-bg bg-ai" data-bg="ai" aria-hidden="true"></div>

  <div class="relative px-5 py-24 sm:px-10 sm:py-32">
    <p class="eyebrow mb-4 opacity-70">02 / for your business</p>
    <h2 id="building-title" class="text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] font-medium tracking-[-0.035em]" data-reveal>
      What are you <span class="serif-accent text-[var(--accent)] transition-colors duration-700">building?</span>
    </h2>
    <p class="mt-4 max-w-xl text-[15px] text-[var(--muted)]" data-reveal>Every site I make starts from how your business works. Pick one to see what that looks like.</p>

    <div role="tablist" aria-label="Business type" class="tabs -mx-5 mt-10 flex gap-3 overflow-x-auto px-5 pb-4 pt-3 sm:mx-0 sm:px-0">
      {industries.map((ind, i) => (
        <button
          role="tab"
          id={`tab-${ind.id}`}
          aria-controls={`panel-${ind.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-id={ind.id}
          class="chip-tab shrink-0 bg-white p-[7px] pb-2.5 text-left text-ink"
        >
          <span class="block h-11 w-[9.5rem]" style={`background:${ind.swatch}`} aria-hidden="true"></span>
          <span class="mt-2 block text-[12.5px] font-bold uppercase tracking-wide">{ind.label}</span>
          <span class="block font-mono text-[9.5px] opacity-60" aria-hidden="true">{ind.code}</span>
        </button>
      ))}
    </div>

    {industries.map((ind, i) => {
      const p = ind.projectSlug ? getProject(ind.projectSlug) : undefined;
      return (
        <div role="tabpanel" id={`panel-${ind.id}`} aria-labelledby={`tab-${ind.id}`} hidden={i !== 0} class="panel mt-8 grid gap-10 lg:grid-cols-[1.35fr_1fr]" tabindex="0">
          <div>
            {p ? (
              <>
                <div class="overflow-hidden rounded-xl shadow-[0_30px_60px_-20px_rgba(0,0,0,.6)]">
                  <div class="flex h-7 items-center gap-1.5 bg-[#2b2b30] px-3" aria-hidden="true">
                    <i class="h-2 w-2 rounded-full bg-[#55555c]"></i><i class="h-2 w-2 rounded-full bg-[#55555c]"></i><i class="h-2 w-2 rounded-full bg-[#55555c]"></i>
                    <span class="ml-3 font-mono text-[10px] text-[#aaa]">{p.live ? new URL(p.live).hostname.replace('www.', '') : p.repo?.replace('https://', '')}</span>
                  </div>
                  <Image src={p.cover.src} alt={p.cover.alt} widths={[640, 1000, 1400]} sizes="(min-width:1024px) 55vw, 100vw" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" />
                </div>
                {p.shots.length > 0 && (
                  <div class="mt-3 grid grid-cols-3 gap-3">
                    {p.shots.slice(-3).map((s) => (
                      <Image src={s.src} alt={s.alt} widths={[320, 560]} sizes="18vw" class="h-24 w-full rounded-lg object-cover object-top sm:h-32" loading="lazy" />
                    ))}
                  </div>
                )}
              </>
            ) : ind.id === 'restaurant' ? (
              <div class="relative flex aspect-[16/10] items-end overflow-hidden rounded-xl bg-[#0b3a2e] p-8 shadow-[0_30px_60px_-20px_rgba(0,0,0,.6)]">
                <div class="absolute right-8 top-8 h-40 w-40 rounded-full border-2 border-[#c9a55b] bg-[radial-gradient(circle,#f4eee3_0_50%,#e6d9bf_51%_70%,transparent_71%)]" aria-hidden="true"></div>
                <p class="font-serif text-5xl italic text-[#f4eee3]">Coastal fire,<br />slow table.</p>
              </div>
            ) : (
              <div class="aspect-[16/10] overflow-hidden rounded-xl bg-[rgba(10,14,80,.55)] p-6 font-mono text-sm leading-7 shadow-[0_30px_60px_-20px_rgba(0,0,0,.6)] sm:p-8">
                <p><span class="opacity-50">$</span> agent run inquiry-triage <span class="opacity-50"># sample run</span></p>
                <p><span class="text-[#ffb27a]">✓</span> read 14 new messages <span class="opacity-60">· tool: email.search</span></p>
                <p><span class="text-[#ffb27a]">✓</span> pulled dates, budgets, venues <span class="opacity-60">· tool: extract</span></p>
                <p><span class="text-[#ffb27a]">✓</span> 3 replies drafted, held for your review</p>
                <p><span class="opacity-50">$</span> <span class="inline-block h-4 w-2 translate-y-[3px] bg-[#9ff0e6]"></span></p>
              </div>
            )}
          </div>

          <div>
            <p class="font-mono text-[11px] uppercase tracking-wide text-[var(--accent)]">{ind.kicker}</p>
            <h3 class="mt-2 text-4xl leading-[1.05] font-medium tracking-[-0.02em]">{ind.title}</h3>
            <p class="serif-accent text-3xl opacity-85">{ind.subtitle}</p>
            <p class="mt-5 text-[13px] text-[var(--muted)]">{ind.intro}</p>
            <ol class="mt-4">
              {ind.needs.map((n, k) => (
                <li class="grid grid-cols-[2rem_1fr] gap-2 border-t border-current/40 py-4 last:border-b">
                  <span class="pt-0.5 font-mono text-[11px] opacity-60">0{k + 1}</span>
                  <div>
                    <p class="text-base font-medium">{n.title}</p>
                    <p class="mt-1 text-[13px] leading-relaxed text-[var(--muted)]">{n.body}</p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="mt-6 flex flex-wrap gap-3 text-sm">
              {p && <a href={`/work/${p.slug}/`} class="rounded-full bg-[var(--accent)] px-5 py-2.5 font-medium text-[var(--on-accent)]">Read the case study →</a>}
              {ind.live && <a href={ind.live} target="_blank" rel="noopener" class="rounded-full border border-current px-5 py-2.5">Visit live site ↗</a>}
              {p?.repo && <a href={p.repo} target="_blank" rel="noopener" class="rounded-full border border-current px-5 py-2.5">View code ↗</a>}
              {!p && <a href="#contact" class="rounded-full bg-[var(--accent)] px-5 py-2.5 font-medium text-[var(--on-accent)]">Start a project →</a>}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .tabs { scrollbar-width: none; }
  .chip-tab { box-shadow: 0 10px 24px -14px rgba(20,20,40,.55); transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s; }
  .chip-tab:hover { transform: translateY(-4px); }
  .chip-tab[aria-selected="true"] { transform: translateY(-10px); box-shadow: 0 22px 34px -14px rgba(0,0,0,.6); outline: 2px solid var(--accent); outline-offset: 0; }
  .panel:not([hidden]) { animation: panelIn .6s cubic-bezier(.2,.7,.2,1); }
  @keyframes panelIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
</style>

<script>
  const section = document.getElementById('building')!;
  const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const select = (tab: HTMLButtonElement, focus = false) => {
    const id = tab.dataset.id!;
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
    section.dataset.theme = id;
    section.querySelectorAll<HTMLElement>('[data-bg]').forEach((bg) => bg.classList.toggle('is-active', bg.dataset.bg === id));
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (dir) { e.preventDefault(); select(tabs[(i + dir + tabs.length) % tabs.length], true); }
      if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
      if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
    });
  });
</script>
