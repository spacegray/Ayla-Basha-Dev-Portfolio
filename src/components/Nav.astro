---
import { site } from '../data/site';
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#building', label: 'For your business' },
  { href: '/#ai', label: 'Agentic AI' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="pointer-events-auto mx-auto flex items-center justify-between px-5 py-4 font-mono text-xs sm:px-10 sm:py-6">
    <a href="/" class="nav-chip rounded-full px-3 py-1.5 tracking-wide">{site.shortName}<span class="opacity-50">&nbsp;/&nbsp;</span>san diego</a>
    <button
      id="menu-btn"
      class="nav-chip flex items-center gap-3 rounded-full px-3 py-1.5"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span id="menu-label">menu</span>
      <span aria-hidden="true" class="flex w-5 flex-col gap-[5px]"><i class="block h-[1.5px] bg-current"></i><i class="block h-[1.5px] bg-current"></i></span>
    </button>
  </div>
</header>

<div id="menu" class="menu fixed inset-0 z-40 hidden flex-col justify-between bg-ink px-5 pb-10 pt-28 text-mist sm:px-10" role="dialog" aria-modal="true" aria-label="Site menu">
  <nav aria-label="Main">
    <ul class="space-y-1">
      {links.map((l, i) => (
        <li><a href={l.href} class="menu-link block text-[13vw] leading-[0.95] font-medium tracking-tight hover:text-candied sm:text-7xl" style={`--i:${i}`}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="flex flex-wrap items-end justify-between gap-6 font-mono text-xs">
    <a href={`mailto:${site.email}`} class="underline decoration-candied underline-offset-4">{site.email}</a>
    <ul class="flex gap-5">
      {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center">{s.label} ↗<span class="sr-only"> (opens in a new tab)</span></a></li>)}
    </ul>
  </div>
</div>

<style>
  .nav-chip {
    background: rgba(242, 242, 242, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--color-ink);
  }
  .menu.is-open { display: flex; animation: menuIn .45s cubic-bezier(.2,.7,.2,1); }
  .menu.is-open .menu-link { animation: linkIn .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 60ms + 80ms); }
  @keyframes menuIn { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes linkIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
</style>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('menu') as HTMLElement;
  const label = document.getElementById('menu-label') as HTMLElement;
  const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>('a, button'));

  function setOpen(open: boolean) {
    menu.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'close' : 'menu';
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) focusables()[0]?.focus();
  }
  btn.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (!menu.classList.contains('is-open')) return;
    if (e.key === 'Escape') { setOpen(false); btn.focus(); }
    if (e.key === 'Tab') {
      const f = [...focusables(), btn];
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
</script>
