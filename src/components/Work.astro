---
import ProjectCard from './ProjectCard.astro';
import { projects, earlierBuilds, categories } from '../data/projects';
const count = (id: string) => (id === 'all' ? projects.length : projects.filter((p) => p.category === id).length);
---
<section id="work" class="foil grain relative isolate overflow-hidden px-5 py-24 sm:px-10 sm:py-32" aria-labelledby="work-title" style="--grain-opacity:.25">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="work-title" class="text-[clamp(2.4rem,6vw,4.75rem)] leading-[0.95] font-medium tracking-[-0.035em]" data-reveal>Selected <span class="serif-accent">work</span></h2>
    <p class="eyebrow opacity-60">03 / Work</p>
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects" data-reveal>
    {categories.map((c, i) => (
      <button type="button" class="filter-chip" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        {c.label} <span class="font-mono text-[11px] opacity-60">{count(c.id)}</span>
      </button>
    ))}
    <p class="sr-only" aria-live="polite" id="work-status"></p>
  </div>

  <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" id="work-grid">
    {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
  </div>

  <div class="mt-20 max-w-3xl" data-reveal>
    <h3 class="eyebrow opacity-70">Earlier builds, 2021–2022</h3>
    <ul class="mt-4 divide-y divide-ink/15 border-y border-ink/15">
      {earlierBuilds.map((b) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
          <span class="font-medium">{b.title}</span>
          <span class="flex-1 text-sm opacity-70">{b.body}</span>
          <a href={b.repo} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-mono text-xs">GitHub ↗<span class="sr-only"> {b.title} (opens in a new tab)</span></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .filter-chip { min-height: 44px; padding: 0 1.1rem; border-radius: 999px; border: 1px solid rgb(23 24 29 / .25); background: rgb(255 255 255 / .55); font-size: .875rem; font-weight: 500; transition: background .25s, color .25s, border-color .25s; }
  .filter-chip:hover { border-color: var(--color-ink); }
  .filter-chip[aria-pressed='true'] { background: var(--color-ink); color: var(--color-mist); border-color: var(--color-ink); }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#work-grid [data-category]');
  const status = document.getElementById('work-status');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const match = f === 'all' || card.dataset.category === f;
        card.hidden = !match;
        if (match) { shown++; card.classList.add('is-in'); }
      });
      if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;
    }),
  );
</script>
