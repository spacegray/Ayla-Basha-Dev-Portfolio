---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-[#07080c] px-5 pb-8 pt-4 font-mono text-[11px] text-white/55 sm:px-10">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6">
    <p>© {year} {site.name} · {site.location}</p>
    <p>Built with Astro and three.js. Designed with light.</p>
  </div>
</footer>
