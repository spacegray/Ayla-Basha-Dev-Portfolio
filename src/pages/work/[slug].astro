---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
interface Props { project: Project }
const { project: p } = Astro.props;
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length];
const hero = p.hero ?? p.cover;
---
<Base title={`${p.title}: ${p.subtitle} | Ayla Basha`} description={p.summary}>
  <article>
    <header class="relative isolate overflow-hidden px-5 pb-16 pt-36 text-white sm:px-10 sm:pt-44" style={`background:${p.chip.swatch}`}>
      <div class="absolute inset-0 -z-10 bg-black/45" aria-hidden="true"></div>
      <a href="/#work" class="inline-flex min-h-11 items-center font-mono text-xs opacity-80">← All work</a>
      <p class="eyebrow mt-8 opacity-80">{p.kind} · {p.year}</p>
      <h1 class="mt-3 text-[clamp(2.8rem,8vw,6.5rem)] leading-[0.92] font-medium tracking-[-0.04em]">{p.title}</h1>
      <p class="serif-accent mt-2 text-[clamp(1.6rem,3.5vw,2.75rem)] opacity-90">{p.subtitle}</p>
      <dl class="mt-10 grid max-w-5xl gap-6 font-mono text-xs sm:grid-cols-2 lg:grid-cols-4">
        <div><dt class="opacity-60">Role</dt><dd class="mt-1">{p.role}</dd></div>
        <div><dt class="opacity-60">Focus</dt><dd class="mt-1">{p.tags.join(', ')}</dd></div>
        {p.stack && <div><dt class="opacity-60">Built with</dt><dd class="mt-1">{p.stack.join(', ')}</dd></div>}
        <div><dt class="opacity-60">Links</dt><dd class="mt-1 flex flex-wrap gap-x-4">
          {p.live && <a href={p.live} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center underline underline-offset-4">Live site ↗</a>}
          {p.repo && <a href={p.repo} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center underline underline-offset-4">Code on GitHub ↗</a>}
        </dd></div>
      </dl>
    </header>

    <div class="bg-mist px-5 py-16 sm:px-10">
      <div class="mx-auto max-w-6xl overflow-hidden rounded-xl shadow-[0_30px_60px_-30px_rgba(20,20,40,.5)]">
        <Image src={hero.src} alt={hero.alt} widths={[640, 1200, 1800]} sizes="(min-width:1200px) 1152px, 100vw" class="block w-full" loading="eager" />
      </div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-16 px-5 py-16 sm:px-10 lg:grid-cols-[1fr_2fr]">
      <h2 class="eyebrow opacity-60">The problem</h2>
      <p class="text-[clamp(1.3rem,2.4vw,1.9rem)] leading-snug tracking-[-0.01em]" data-reveal>{p.caseStudy.context}</p>

      <h2 class="eyebrow opacity-60">What it had to do</h2>
      <ol class="grid gap-0" data-reveal>
        {p.caseStudy.needs.map((n, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] border-t border-ink/20 py-5 last:border-b">
            <span class="font-mono text-xs opacity-50">0{i + 1}</span>
            <div><p class="text-lg font-medium">{n.title}</p><p class="mt-1 text-[15px] leading-relaxed opacity-75">{n.body}</p></div>
          </li>
        ))}
      </ol>

      <h2 class="eyebrow opacity-60">Constraints and tradeoffs</h2>
      <ul class="list-disc space-y-2 pl-5 text-[15px] leading-relaxed opacity-85" data-reveal>
        {p.caseStudy.constraints.map((c) => <li>{c}</li>)}
      </ul>

      <h2 class="eyebrow opacity-60">How it flows</h2>
      <ol class="flex flex-wrap items-center gap-2 font-mono text-xs" aria-label="Page and data flow" data-reveal>
        {p.caseStudy.flow.map((f, i) => (
          <>
            <li class="rounded-full border border-ink/25 bg-white px-3.5 py-2">{f}</li>
            {i < p.caseStudy.flow.length - 1 && <li aria-hidden="true" class="opacity-40">→</li>}
          </>
        ))}
      </ol>
    </div>

    {p.shots.length > 0 && (
      <section class="bg-white px-5 py-16 sm:px-10" aria-labelledby="screens">
        <h2 id="screens" class="eyebrow mx-auto max-w-6xl opacity-60">Screens</h2>
        <div class:list={['mx-auto mt-8 grid max-w-6xl gap-8', p.phoneShots ? 'grid-cols-2 md:grid-cols-4' : 'md:grid-cols-2']}>
          {p.shots.map((s, i) => (
            <figure data-reveal style={`--i:${i % (p.phoneShots ? 4 : 2)}`}>
              <Image src={s.src} alt={s.alt} widths={p.phoneShots ? [300, 600] : [560, 900, 1200]} sizes={p.phoneShots ? '(min-width:768px) 25vw, 50vw' : '(min-width:768px) 50vw, 100vw'} class="w-full rounded-lg border border-ink/10" loading="lazy" />
              {s.caption && <figcaption class="mt-2 font-mono text-xs opacity-60">{s.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <div class="mx-auto grid max-w-6xl gap-16 px-5 py-16 sm:px-10 lg:grid-cols-[1fr_2fr]">
      <h2 class="eyebrow opacity-60">Approach</h2>
      <ul class="space-y-3 text-[clamp(1.1rem,2vw,1.4rem)] leading-snug" data-reveal>
        {p.caseStudy.lessons.map((l) => <li>{l}</li>)}
      </ul>
    </div>

    <nav class="bg-ink px-5 py-16 text-mist sm:px-10" aria-label="Next project">
      <p class="eyebrow opacity-60">Next project</p>
      <a href={`/work/${next.slug}/`} class="mt-3 block text-[clamp(2.2rem,6vw,4.5rem)] leading-none font-medium tracking-tight hover:text-candied">{next.title} →</a>
      <a href="/#contact" class="mt-10 inline-block rounded-full bg-white px-6 py-3 text-sm font-medium text-ink hover:bg-candied">Start a project like this</a>
    </nav>
  </article>
</Base>
